{
  "$schema": "https://antigravity.google/schemas/workflow-dag-v1.json",
  "workflowId": "tri-planar-code-gen-dag",
  "name": "Language-Agnostic Tri-Planar Multi-Agent Code Generation & Verification DAG",
  "version": "1.0.0",
  "description": "Declarative Outer-Loop orchestration blueprint for Google Antigravity coordinating Claude Code (Deep Reasoning/Domain Core) and GitHub Copilot (Mechanical/QA) across isolated Git Worktrees with a language-agnostic Deterministic Oracle Substrate.",
  "metadata": {
    "targetStack": "Language-Agnostic (configured via .harness/harness.env and harness.config.json)",
    "architectureModel": "Tri-Planar Dual-Loop with Deterministic Oracle Substrate",
    "repositoryRoot": ".",
    "integrationBranch": "origin/develop",
    "protectedBranches": ["main", "master"],
    "maxConcurrentWorktrees": 5
  },
  "agents": {
    "orchestrator": {
      "id": "google-antigravity",
      "plane": "ControlPlane-OuterLoop",
      "role": "DAG Orchestrator, Worktree Lifecycle Manager, Deterministic Gatekeeper, and Merge Coordinator",
      "contracts": ["AGENTS.md", "CLAUDE.md", "AI-AUGMENTED-DEVELOPMENT.md"]
    },
    "reasoningSpecialist": {
      "id": "claude-code",
      "plane": "ExecutionPlane-InnerLoop-DeepReasoning",
      "role": "Domain Modeling, Clean/Hexagonal Architecture Refactoring, Complex Algorithms, and Self-Healing Diagnostic Repair",
      "contractFile": "CLAUDE.md",
      "skills": [
        ".claude/skills/solid-code-synthesizer/SKILL.md",
        ".claude/skills/architecture-conventions/SKILL.md",
        ".claude/skills/observability-conventions/SKILL.md",
        ".claude/skills/jira-conventions/SKILL.md",
        ".claude/skills/ui-ux-pro-max/SKILL.md"
      ]
    },
    "mechanicalWorker": {
      "id": "github-copilot",
      "plane": "ExecutionPlane-InnerLoop-MechanicalQA",
      "role": "Fast Mechanical Scaffolding, DTO/Adapter Generation, Test Data Builders, LSP Contract Suites, 100%-Branch Unit Tests, and Formatting",
      "contractFile": ".github/copilot-instructions.md",
      "skills": [
        ".github/skills/solid-code-synthesizer/SKILL.md"
      ]
    }
  },
  "oracleSubstrate": {
    "harnessEnv": "./.harness/harness.env",
    "harnessConfig": "./harness.config.json",
    "sandboxScript": "./scripts/agent-sandbox.sh",
    "solidVerifierScript": "./scripts/verify-solid-contracts.py",
    "verifierScript": "./scripts/verify-agent-worktree.sh",
    "exitCodeMap": {
      "0": "PASS_VERIFIED",
      "2": "FATAL_ENVIRONMENT_OR_PROTECTED_BRANCH_VIOLATION",
      "10": "FAIL_STAGE_1_FORMAT_OR_DISJOINT_SCOPE",
      "20": "FAIL_STAGE_2_COMPILER_TYPECHECK_LINTER_OR_SUPPRESSION",
      "30": "FAIL_STAGE_3_ARCHITECTURE_SOLID_OR_INVARIANT_TEST"
    }
  },
  "parameters": {
    "taskId": {
      "type": "string",
      "required": true,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Issue/Jira ticket key or task slug (e.g., 'PROJ-42-order-settlement')"
    },
    "baseRef": {
      "type": "string",
      "default": "origin/develop",
      "forbiddenValues": ["main", "origin/main", "master", "origin/master"]
    },
    "maxSelfHealRetries": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 5
    }
  },
  "phases": [
    {
      "phaseId": "phase-1-decompose-and-init-worktree",
      "name": "Phase 1: Task Decomposition & Worktree Initialization",
      "owner": "google-antigravity",
      "dependsOn": [],
      "steps": [
        {
          "stepId": "1.1-decompose-task",
          "action": "analyze_and_decompose",
          "description": "Read .harness/harness.env and harness.config.json, verify dependency graph (Blocks links + prose 'Depends on'), define an explicit Shared Type/Interface Contract, and assign strictly disjoint file paths (2A ∩ 2B = ∅) between Claude Code (coreLogicSpec) and GitHub Copilot (testAndBoilerplateSpec).",
          "outputs": ["sharedContractSpec", "coreLogicSpec", "testAndBoilerplateSpec"]
        },
        {
          "stepId": "1.2-provision-worktree",
          "action": "shell_exec",
          "command": "./scripts/agent-sandbox.sh create {{parameters.taskId}} {{parameters.baseRef}}",
          "workingDirectory": ".",
          "expectedExitCode": 0
        }
      ]
    },
    {
      "phaseId": "phase-2-parallel-agent-dispatch",
      "name": "Phase 2: Parallel Inner-Loop Dispatch (2A ⊗ 2B)",
      "owner": "google-antigravity",
      "dependsOn": ["phase-1-decompose-and-init-worktree"],
      "executionMode": "parallel",
      "branches": [
        {
          "branchId": "2A-claude-code-core-domain",
          "agent": "claude-code",
          "workingDirectory": "../worktrees/{{parameters.taskId}}",
          "inputs": ["sharedContractSpec", "coreLogicSpec", "CLAUDE.md"],
          "outputs": ["modifiedProductionFiles"]
        },
        {
          "branchId": "2B-copilot-tests-and-boilerplate",
          "agent": "github-copilot",
          "workingDirectory": "../worktrees/{{parameters.taskId}}",
          "inputs": ["sharedContractSpec", "testAndBoilerplateSpec", ".github/copilot-instructions.md"],
          "outputs": ["modifiedTestAndBoilerplateFiles"]
        }
      ],
      "joinBarrier": "all_branches_completed"
    },
    {
      "phaseId": "phase-3-deterministic-oracle-verification",
      "name": "Phase 3: Execution of the Deterministic Oracles",
      "owner": "google-antigravity",
      "dependsOn": ["phase-2-parallel-agent-dispatch"],
      "steps": [
        {
          "stepId": "3.1-run-solid-and-scope-preflight",
          "action": "shell_exec",
          "command": "python3 ./scripts/verify-solid-contracts.py --target ../worktrees/{{parameters.taskId}} --base {{parameters.baseRef}}"
        },
        {
          "stepId": "3.2-run-oracle-gatekeeper",
          "action": "shell_exec",
          "command": "./scripts/verify-agent-worktree.sh ../worktrees/{{parameters.taskId}}",
          "transitions": {
            "0": "phase-5-worktree-cleanup-and-merge-prep",
            "10": "phase-4-feedback-self-healing-loop",
            "20": "phase-4-feedback-self-healing-loop",
            "30": "phase-4-feedback-self-healing-loop",
            "2": "abort_workflow"
          }
        }
      ]
    },
    {
      "phaseId": "phase-4-feedback-self-healing-loop",
      "name": "Phase 4: Bounded Self-Healing Loop with Pre-Retry Tree Snapshot",
      "owner": "google-antigravity",
      "dependsOn": ["phase-3-deterministic-oracle-verification"],
      "loopPolicy": {
        "maxIterations": "{{parameters.maxSelfHealRetries}}",
        "preIterationCheckpoint": "git -C ../worktrees/{{parameters.taskId}} stash create"
      },
      "routingRules": [
        {
          "whenExitCode": 10,
          "failureCategory": "FormattingOrScopeDrift",
          "targetAgent": "github-copilot"
        },
        {
          "whenExitCode": 20,
          "failureCategory": "CompilerTypecheckOrLinterViolation",
          "targetAgent": "claude-code"
        },
        {
          "whenExitCode": 30,
          "failureCategory": "ArchitectureSolidOrTestFailure",
          "targetAgent": "claude-code"
        }
      ],
      "postIterationTransition": "phase-3-deterministic-oracle-verification"
    },
    {
      "phaseId": "phase-5-worktree-cleanup-and-merge-prep",
      "name": "Phase 5: Rebase on origin/develop, Post-Rebase Re-Verify & Merge Prep",
      "owner": "google-antigravity",
      "dependsOn": ["phase-3-deterministic-oracle-verification"],
      "steps": [
        {
          "stepId": "5.1-rebase-onto-develop",
          "action": "shell_exec",
          "workingDirectory": "../worktrees/{{parameters.taskId}}",
          "command": "git fetch origin develop && git rebase origin/develop"
        },
        {
          "stepId": "5.2-post-rebase-oracle-recheck",
          "action": "shell_exec",
          "workingDirectory": ".",
          "command": "./scripts/verify-agent-worktree.sh ../worktrees/{{parameters.taskId}}",
          "expectedExitCode": 0
        }
      ]
    }
  ]
}
