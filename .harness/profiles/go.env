# Go Profile (gofmt + go vet / golangci-lint + go test)
STACK_PROFILE="go"
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

INIT_CMD="go mod download"
FORMAT_CHECK_CMD="test -z \"\$(gofmt -l .)\""
FORMAT_FIX_CMD="gofmt -w ."
BUILD_AND_LINT_CMD="go build ./... && go vet ./... && (command -v golangci-lint >/dev/null 2>&1 && golangci-lint run || true)"
ARCH_TEST_CMD="go test -run Architecture ./..."
UNIT_TEST_CMD="go test -race ./..."
