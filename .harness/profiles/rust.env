# Rust Profile (cargo fmt + cargo clippy -D warnings + cargo test)
STACK_PROFILE="rust"
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

INIT_CMD="cargo fetch"
FORMAT_CHECK_CMD="cargo fmt --all -- --check"
FORMAT_FIX_CMD="cargo fmt --all"
BUILD_AND_LINT_CMD="cargo clippy --all-targets --all-features -- -D warnings"
ARCH_TEST_CMD="cargo test architecture"
UNIT_TEST_CMD="cargo test --all-targets"
