# Python Profile (uv + Ruff + Mypy/Pyright strict + Pytest)
STACK_PROFILE="python-uv"
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

INIT_CMD="uv sync --frozen || uv sync"
FORMAT_CHECK_CMD="uv run ruff format --check ."
FORMAT_FIX_CMD="uv run ruff format ."
BUILD_AND_LINT_CMD="uv run ruff check . && uv run mypy --strict src"
ARCH_TEST_CMD="uv run pytest -m architecture || uv run pytest tests/architecture"
UNIT_TEST_CMD="uv run pytest"
