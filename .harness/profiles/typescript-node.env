# TypeScript / Node.js Profile (npm / pnpm + Prettier + ESLint + tsc + Vitest)
STACK_PROFILE="typescript-node"
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

INIT_CMD="npm ci"
FORMAT_CHECK_CMD="npx prettier --check ."
FORMAT_FIX_CMD="npx prettier --write ."
BUILD_AND_LINT_CMD="npx tsc --noEmit && npx eslint . --max-warnings 0"
ARCH_TEST_CMD="npm run test:arch --if-present"
UNIT_TEST_CMD="npm test"
