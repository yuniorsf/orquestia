# .NET / C# Profile (dotnet format + dotnet build /warnaserror + Architecture & Unit Tests)
STACK_PROFILE="dotnet"
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

INIT_CMD="dotnet restore --nologo --verbosity quiet"
FORMAT_CHECK_CMD="dotnet format style --verify-no-changes --no-restore"
FORMAT_FIX_CMD="dotnet format style"
BUILD_AND_LINT_CMD="dotnet build --no-incremental /warnaserror -consoleLoggerParameters:NoSummary"
ARCH_TEST_CMD="dotnet test --no-build --nologo --filter \"FullyQualifiedName~Architecture|Category=Architecture\""
UNIT_TEST_CMD="dotnet test --no-build --nologo"
