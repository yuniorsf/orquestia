# ==============================================================================
# Multi-Agent Deterministic Oracle & Worktree Harness Profile (Active)
# ==============================================================================
# Run `./scripts/init-project-stack.sh <typescript|python|go|rust|dotnet> <Name> <KEY>`
# to populate this file from `.harness/profiles/<stack>.env`, or customize directly.
# ==============================================================================

PROJECT_NAME="<app>"
STACK_PROFILE="generic"
TICKET_PREFIX="PROJ"

# Branching Policy (Non-negotiable: agents never branch from or merge into main/master)
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

# Worktree Initialization Command (executed inside ../worktrees/<task-id> on create/init)
INIT_CMD="echo '[HARNESS] Generic profile active — configure INIT_CMD in .harness/harness.env'"

# 3-Stage Deterministic Oracle Commands (executed by scripts/verify-agent-worktree.sh)
# Stage 1 (Exit 10 on failure): Formatting & code-style verification (read-only check)
FORMAT_CHECK_CMD="python3 scripts/verify-solid-contracts.py --target ."
# Auto-remediation command routed to GitHub Copilot (Branch 2B) on Exit 10:
FORMAT_FIX_CMD="echo '[HARNESS] Configure FORMAT_FIX_CMD in .harness/harness.env'"

# Stage 2 (Exit 20 on failure): Strict compilation, typecheck & static analysis (warnings-as-errors)
BUILD_AND_LINT_CMD="python3 scripts/verify-solid-contracts.py --target ."

# Stage 3 (Exit 30 on failure): Architecture boundary & domain-invariant tests
ARCH_TEST_CMD="python3 scripts/verify-solid-contracts.py --target ."

# Full Unit & Integration Test Suite (executed post-rebase and before --ship / PR creation)
UNIT_TEST_CMD="echo '[HARNESS] Configure UNIT_TEST_CMD in .harness/harness.env'"
