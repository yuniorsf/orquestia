{
  "$schema": "https://antigravity.google/schemas/workflow-dag-v1.json",
  "workflowId": "handoff-swarm-code-gen-dag",
  "name": "Language-Agnostic Handoff/Swarm Code Generation & Verification DAG",
  "version": "1.0.0",
  "description": "Declarative Outer-Loop orchestration blueprint for Google Antigravity coordinating the workers configured in orquestia.config.yaml's orchestration.handoff_swarm.workers[], dispatched strictly in sequence, across isolated Git Worktrees with a language-agnostic Deterministic Oracle Substrate.",
  "metadata": {
    "targetStack": "Language-Agnostic (configured via .harness/harness.env and harness.config.json)",
    "architectureModel": "Handoff/Swarm Dual-Loop with Deterministic Oracle Substrate",
    "repositoryRoot": ".",
    "integrationBranch": "origin/develop",
    "protectedBranches": ["main", "master"],
    "maxConcurrentWorktrees": 5,
    "workerCount": {{WORKER_COUNT}}
  },
  "agents": {
    "orchestrator": {
      "id": "google-antigravity",
      "plane": "ControlPlane-OuterLoop",
      "role": "DAG Orchestrator, Worktree Lifecycle Manager, Deterministic Gatekeeper, and Merge Coordinator",
      "contracts": ["AGENTS.md", "CLAUDE.md", "AI-AUGMENTED-DEVELOPMENT.md"]
    },
    "workers": {{WORKERS_JSON}}
  },
  "oracleSubstrate": {
    "harnessEnv": "./.harness/harness.env",
    "harnessConfig": "./harness.config.json",
    "sandboxScript": "./scripts/agent-sandbox.sh",
    "solidVerifierScript": "./scripts/verify-solid-contracts.py",
    "verifierScript": "./scripts/verify-agent-worktree.sh",
    "exitCodeMap": {
      "0": "PASS_VERIFIED",
      "2": "FATAL_ENVIRONMENT_OR_PROTECTED_BRANCH_VIOLATION",
      "10": "FAIL_STAGE_1_FORMAT_OR_DISJOINT_SCOPE",
      "20": "FAIL_STAGE_2_COMPILER_TYPECHECK_LINTER_OR_SUPPRESSION",
      "30": "FAIL_STAGE_3_ARCHITECTURE_SOLID_OR_INVARIANT_TEST"
    }
  },
  "parameters": {
    "taskId": {
      "type": "string",
      "required": true,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Issue/Jira ticket key or task slug (e.g., 'PROJ-42-order-settlement')"
    },
    "baseRef": {
      "type": "string",
      "default": "origin/develop",
      "forbiddenValues": ["main", "origin/main", "master", "origin/master"]
    },
    "maxSelfHealRetries": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 5
    }
  },
  "phases": [
    {
      "phaseId": "phase-1-decompose-and-init-worktree",
      "name": "Phase 1: Task Decomposition & Worktree Initialization",
      "owner": "google-antigravity",
      "dependsOn": [],
      "steps": [
        {
          "stepId": "1.1-decompose-task",
          "action": "analyze_and_decompose",
          "description": "Read .harness/harness.env and harness.config.json, define an explicit Shared Type/Interface Contract, and assign strictly disjoint file paths across every configured worker in the handoff sequence.",
          "outputs": ["sharedContractSpec", "perWorkerSpec"]
        },
        {
          "stepId": "1.2-provision-worktree",
          "action": "shell_exec",
          "command": "./scripts/agent-sandbox.sh create {{parameters.taskId}} {{parameters.baseRef}}",
          "workingDirectory": ".",
          "expectedExitCode": 0
        }
      ]
    },
    {
      "phaseId": "phase-2-sequential-worker-handoff",
      "name": "Phase 2: Sequential Inner-Loop Handoff (no central join barrier)",
      "owner": "google-antigravity",
      "dependsOn": ["phase-1-decompose-and-init-worktree"],
      "executionMode": "sequential",
      "chain": {{BRANCHES_JSON}}
    },
    {
      "phaseId": "phase-3-deterministic-oracle-verification",
      "name": "Phase 3: Execution of the Deterministic Oracles",
      "owner": "google-antigravity",
      "dependsOn": ["phase-2-sequential-worker-handoff"],
      "steps": [
        {
          "stepId": "3.1-run-solid-and-scope-preflight",
          "action": "shell_exec",
          "command": "python3 ./scripts/verify-solid-contracts.py --target ../worktrees/{{parameters.taskId}} --base {{parameters.baseRef}} {{WORKER_SCOPE_FLAGS}}"
        },
        {
          "stepId": "3.2-run-oracle-gatekeeper",
          "action": "shell_exec",
          "command": "./scripts/verify-agent-worktree.sh ../worktrees/{{parameters.taskId}}",
          "transitions": {
            "0": "phase-5-worktree-cleanup-and-merge-prep",
            "10": "phase-4-feedback-self-healing-loop",
            "20": "phase-4-feedback-self-healing-loop",
            "30": "phase-4-feedback-self-healing-loop",
            "2": "abort_workflow"
          }
        }
      ]
    },
    {
      "phaseId": "phase-4-feedback-self-healing-loop",
      "name": "Phase 4: Bounded Self-Healing Loop with Pre-Retry Tree Snapshot",
      "owner": "google-antigravity",
      "dependsOn": ["phase-3-deterministic-oracle-verification"],
      "loopPolicy": {
        "maxIterations": "{{parameters.maxSelfHealRetries}}",
        "preIterationCheckpoint": "git -C ../worktrees/{{parameters.taskId}} stash create"
      },
      "routingRules": [
        {
          "whenExitCode": 10,
          "failureCategory": "FormattingOrScopeDrift",
          "targetAgent": "overlapping-workers"
        },
        {
          "whenExitCode": 20,
          "failureCategory": "CompilerTypecheckOrLinterViolation",
          "targetAgent": "owning-worker"
        },
        {
          "whenExitCode": 30,
          "failureCategory": "ArchitectureSolidOrTestFailure",
          "targetAgent": "intersecting-workers"
        }
      ],
      "postIterationTransition": "phase-3-deterministic-oracle-verification"
    },
    {
      "phaseId": "phase-5-worktree-cleanup-and-merge-prep",
      "name": "Phase 5: Rebase on origin/develop, Post-Rebase Re-Verify & Merge Prep",
      "owner": "google-antigravity",
      "dependsOn": ["phase-3-deterministic-oracle-verification"],
      "steps": [
        {
          "stepId": "5.1-rebase-onto-develop",
          "action": "shell_exec",
          "workingDirectory": "../worktrees/{{parameters.taskId}}",
          "command": "git fetch origin develop && git rebase origin/develop"
        },
        {
          "stepId": "5.2-post-rebase-oracle-recheck",
          "action": "shell_exec",
          "workingDirectory": ".",
          "command": "./scripts/verify-agent-worktree.sh ../worktrees/{{parameters.taskId}}",
          "expectedExitCode": 0
        }
      ]
    }
  ]
}
