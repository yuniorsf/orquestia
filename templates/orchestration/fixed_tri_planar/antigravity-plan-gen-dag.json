{
  "$schema": "https://antigravity.google/schemas/workflow-dag-v1.json",
  "workflowId": "tri-planar-plan-gen-dag",
  "name": "Language-Agnostic Tri-Planar Multi-Agent Planning & Architecture Verification DAG",
  "version": "1.0.0",
  "description": "Declarative read-only Outer-Loop planning blueprint for Google Antigravity coordinating Claude Code (Architecture/Domain Reasoning) and GitHub Copilot (Type Signatures/QA Test Matrix) with a Deterministic Plan Oracle and zero repository mutations.",
  "metadata": {
    "targetStack": "Language-Agnostic (configured via .harness/harness.env and harness.config.json)",
    "architectureModel": "Tri-Planar Dual-Loop Read-Only Planning with Deterministic Plan Oracle",
    "repositoryRoot": ".",
    "baselineBranch": "origin/develop",
    "mutationPolicy": "READ_ONLY_ZERO_REPO_CHANGES",
    "handoffTargetWorkflow": "tri-planar-code-gen-dag"
  },
  "agents": {
    "orchestrator": {
      "id": "google-antigravity",
      "plane": "ControlPlane-OuterLoop",
      "executionPermissions": "read_only_repo_plus_conversation_artifact",
      "contracts": ["AGENTS.md", "CLAUDE.md", ".antigravity/workflows/code-gen-dag.json"]
    },
    "reasoningSpecialist": {
      "id": "claude-code",
      "plane": "ExecutionPlane-InnerLoop-DeepReasoning",
      "executionPermissions": "read_only",
      "contractFile": "CLAUDE.md",
      "personas": [
        ".claude/agents/arch-designer.md",
        ".claude/agents/feat-analyzer.md",
        ".claude/agents/task-planner.md"
      ],
      "skills": [
        ".claude/skills/solid-code-synthesizer/SKILL.md",
        ".claude/skills/architecture-conventions/SKILL.md",
        ".claude/skills/observability-conventions/SKILL.md",
        ".claude/skills/jira-conventions/SKILL.md",
        ".claude/skills/ui-ux-pro-max/SKILL.md"
      ]
    },
    "mechanicalWorker": {
      "id": "github-copilot",
      "plane": "ExecutionPlane-InnerLoop-MechanicalQA",
      "executionPermissions": "read_only",
      "contractFile": ".github/copilot-instructions.md",
      "personas": [".claude/agents/test-agent.md"],
      "skills": [".github/skills/solid-code-synthesizer/SKILL.md"]
    }
  },
  "planOracleSubstrate": {
    "harnessEnv": "./.harness/harness.env",
    "harnessConfig": "./harness.config.json",
    "statusCodeMap": {
      "0": "PASS_PLAN_VERIFIED",
      "2": "FATAL_REPO_MUTATION_DETECTED",
      "10": "FAIL_STAGE_1_PATH_EXISTENCE_OR_DISJOINT_OWNERSHIP",
      "20": "FAIL_STAGE_2_BANNED_API_OR_SUPPRESSION_GUARDRAIL",
      "30": "FAIL_STAGE_3_CLEAN_ARCHITECTURE_SOLID_OR_COVERAGE_GAP"
    }
  },
  "parameters": {
    "taskId": {
      "type": "string",
      "required": true,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "baseRef": {
      "type": "string",
      "default": "origin/develop",
      "forbiddenValues": ["main", "origin/main", "master", "origin/master"]
    },
    "maxSelfHealRetries": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 5
    },
    "outputPath": {
      "type": "string",
      "required": false
    }
  }
}
