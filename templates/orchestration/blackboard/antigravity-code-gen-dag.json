{
  "$schema": "https://antigravity.google/schemas/workflow-dag-v1.json",
  "workflowId": "blackboard-code-gen-dag",
  "name": "Language-Agnostic Blackboard Code Generation & Verification DAG",
  "version": "1.0.0",
  "description": "Declarative Outer-Loop orchestration blueprint for Google Antigravity coordinating the contributors configured in orquestia.config.yaml's orchestration.blackboard.contributors[], dispatched in parallel against a shared workspace and merged by last-writer-wins, across isolated Git Worktrees with a language-agnostic Deterministic Oracle Substrate.",
  "metadata": {
    "targetStack": "Language-Agnostic (configured via .harness/harness.env and harness.config.json)",
    "architectureModel": "Blackboard Dual-Loop with Deterministic Oracle Substrate",
    "repositoryRoot": ".",
    "integrationBranch": "origin/develop",
    "protectedBranches": ["main", "master"],
    "maxConcurrentWorktrees": 5,
    "workerCount": {{WORKER_COUNT}},
    "conflictResolution": "last_writer_wins"
  },
  "agents": {
    "orchestrator": {
      "id": "google-antigravity",
      "plane": "ControlPlane-OuterLoop",
      "role": "DAG Orchestrator, Worktree Lifecycle Manager, Merge Coordinator, Deterministic Gatekeeper",
      "contracts": ["AGENTS.md", "CLAUDE.md", "AI-AUGMENTED-DEVELOPMENT.md"]
    },
    "workers": {{WORKERS_JSON}}
  },
  "oracleSubstrate": {
    "harnessEnv": "./.harness/harness.env",
    "harnessConfig": "./harness.config.json",
    "sandboxScript": "./scripts/agent-sandbox.sh",
    "solidVerifierScript": "./scripts/verify-solid-contracts.py",
    "solidVerifierNote": "Run WITHOUT --worker-scope/--scope-a/--scope-b — disjoint ownership does not apply; the merge step already resolved any contested path.",
    "verifierScript": "./scripts/verify-agent-worktree.sh",
    "exitCodeMap": {
      "0": "PASS_VERIFIED",
      "2": "FATAL_ENVIRONMENT_OR_PROTECTED_BRANCH_VIOLATION",
      "10": "FAIL_STAGE_1_FORMAT_DRIFT_ONLY",
      "20": "FAIL_STAGE_2_COMPILER_TYPECHECK_LINTER_OR_SUPPRESSION",
      "30": "FAIL_STAGE_3_ARCHITECTURE_SOLID_OR_INVARIANT_TEST"
    }
  },
  "parameters": {
    "taskId": {
      "type": "string",
      "required": true,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Issue/Jira ticket key or task slug (e.g., 'PROJ-42-order-settlement')"
    },
    "baseRef": {
      "type": "string",
      "default": "origin/develop",
      "forbiddenValues": ["main", "origin/main", "master", "origin/master"]
    },
    "maxSelfHealRetries": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 5
    }
  },
  "phases": [
    {
      "phaseId": "phase-1-decompose-and-init-worktree",
      "name": "Phase 1: Task Decomposition & Worktree Initialization",
      "owner": "google-antigravity",
      "dependsOn": [],
      "steps": [
        {
          "stepId": "1.1-decompose-task",
          "action": "analyze_and_decompose",
          "description": "Read .harness/harness.env and harness.config.json, define an explicit Shared Type/Interface Contract — do NOT partition files between contributors; any contributor may propose changes to any in-scope file.",
          "outputs": ["sharedContractSpec"]
        },
        {
          "stepId": "1.2-provision-worktree",
          "action": "shell_exec",
          "command": "./scripts/agent-sandbox.sh create {{parameters.taskId}} {{parameters.baseRef}}",
          "workingDirectory": ".",
          "expectedExitCode": 0
        }
      ]
    },
    {
      "phaseId": "phase-2-parallel-contributor-dispatch-and-merge",
      "name": "Phase 2: Parallel Contributor Dispatch Against Shared Workspace, then Last-Writer-Wins Merge",
      "owner": "google-antigravity",
      "dependsOn": ["phase-1-decompose-and-init-worktree"],
      "executionMode": "parallel",
      "branches": {{BRANCHES_JSON}},
      "joinBarrier": "all_branches_completed",
      "postJoinStep": {
        "action": "merge_last_writer_wins",
        "description": "BlackboardTopology resolves any contested file path to whichever contribution has the latest logical write timestamp before anything is written to the real worktree."
      }
    },
    {
      "phaseId": "phase-3-deterministic-oracle-verification",
      "name": "Phase 3: Execution of the Deterministic Oracle (no disjoint-scope check)",
      "owner": "google-antigravity",
      "dependsOn": ["phase-2-parallel-contributor-dispatch-and-merge"],
      "steps": [
        {
          "stepId": "3.1-run-oracle-gatekeeper",
          "action": "shell_exec",
          "command": "./scripts/verify-agent-worktree.sh ../worktrees/{{parameters.taskId}}",
          "transitions": {
            "0": "phase-5-worktree-cleanup-and-merge-prep",
            "10": "phase-4-feedback-self-healing-loop",
            "20": "phase-4-feedback-self-healing-loop",
            "30": "phase-4-feedback-self-healing-loop",
            "2": "abort_workflow"
          }
        }
      ]
    },
    {
      "phaseId": "phase-4-feedback-self-healing-loop",
      "name": "Phase 4: Bounded Self-Healing Loop with Pre-Retry Tree Snapshot",
      "owner": "google-antigravity",
      "dependsOn": ["phase-3-deterministic-oracle-verification"],
      "loopPolicy": {
        "maxIterations": "{{parameters.maxSelfHealRetries}}",
        "preIterationCheckpoint": "git -C ../worktrees/{{parameters.taskId}} stash create"
      },
      "routingRules": [
        {
          "whenExitCode": 10,
          "failureCategory": "FormattingDriftOnly",
          "targetAgent": "any-contributor"
        },
        {
          "whenExitCode": 20,
          "failureCategory": "CompilerTypecheckOrLinterViolation",
          "targetAgent": "merged-manifest-owner"
        },
        {
          "whenExitCode": 30,
          "failureCategory": "ArchitectureSolidOrTestFailure",
          "targetAgent": "merged-manifest-owner"
        }
      ],
      "postIterationTransition": "phase-3-deterministic-oracle-verification"
    },
    {
      "phaseId": "phase-5-worktree-cleanup-and-merge-prep",
      "name": "Phase 5: Rebase on origin/develop, Post-Rebase Re-Verify & Merge Prep",
      "owner": "google-antigravity",
      "dependsOn": ["phase-3-deterministic-oracle-verification"],
      "steps": [
        {
          "stepId": "5.1-rebase-onto-develop",
          "action": "shell_exec",
          "workingDirectory": "../worktrees/{{parameters.taskId}}",
          "command": "git fetch origin develop && git rebase origin/develop"
        },
        {
          "stepId": "5.2-post-rebase-oracle-recheck",
          "action": "shell_exec",
          "workingDirectory": ".",
          "command": "./scripts/verify-agent-worktree.sh ../worktrees/{{parameters.taskId}}",
          "expectedExitCode": 0
        }
      ]
    }
  ]
}
