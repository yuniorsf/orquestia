{
  "name": "orquestia-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@orquestia/core && npm run build --workspaces --if-present",
    "test": "vitest run --coverage",
    "test:arch": "echo \"[harness] no dedicated architecture test suite yet\"",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@vscode/vsce": {
      "minimatch": "^11.0.5"
    }
  }
}
