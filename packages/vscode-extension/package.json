{
  "name": "orquestia",
  "displayName": "Orquestia",
  "description": "Kanban board, live worktree diff previews, and one-click Plan/Code DAG execution for the Orquestia Tri-Planar multi-agent orchestrator.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "orquestia",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuniorsf/orquestia.git"
  },
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "orquestia.openKanbanBoard",
        "title": "Orquestia: Open Kanban Board"
      },
      {
        "command": "orquestia.showWorktreeDiff",
        "title": "Orquestia: Show Worktree Diff Preview"
      },
      {
        "command": "orquestia.runPlanDag",
        "title": "Orquestia: Run Plan DAG"
      },
      {
        "command": "orquestia.runCodeDag",
        "title": "Orquestia: Run Code DAG"
      }
    ]
  },
  "activationEvents": [
    "onCommand:orquestia.openKanbanBoard",
    "onCommand:orquestia.showWorktreeDiff",
    "onCommand:orquestia.runPlanDag",
    "onCommand:orquestia.runCodeDag"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "npm run build && node dist-tsc/run-bundle.js",
    "build:vsix": "npm run build:bundle && vsce package --no-dependencies --out dist/orquestia.vsix"
  },
  "dependencies": {
    "@orquestia/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.21.5"
  }
}
